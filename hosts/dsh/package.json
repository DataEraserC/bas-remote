{
  "name": "bas-remote",
  "version": "0.7.3",
  "description": "SAP Business Application Studio (BAS) dev spaces: landscape login, dev-space lifecycle and SSH dev-channel tunnels. The protocol is a Rust library behind a C ABI; this package is the DeepSeek Harness host.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "native"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.0 || ^0.2.0 || 0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0 || ^0.2.0 || 0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.1.0 || ^0.2.0 || 0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0 || ^0.2.0 || 0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "scripts": {
    "test": "node test/client.test.mjs && node test/ports.test.mjs && node test/host-native.test.mjs",
    "test:live": "node test/live-devspace.mjs",
    "test:native": "node test/native.test.mjs",
    "build:native": "cargo build --release -p bas-api"
  }
}
